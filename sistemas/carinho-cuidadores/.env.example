# ============================================
# CARINHO CUIDADORES - Variáveis de Ambiente
# ============================================
# Exemplos apenas. Não use estes valores em produção.
# Secrets: CATALOGO-SECRETS.md na raiz.

# --------------------------------------------
# Aplicação
# --------------------------------------------
APP_NAME="Carinho Cuidadores"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://cuidadores.carinho.com.vc
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# --------------------------------------------
# Banco de Dados (MariaDB 10.11, driver mysql)
# --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=carinho-mariadb
DB_PORT=3306
DB_DATABASE=carinho_cuidadores
DB_USERNAME=carinho
DB_PASSWORD=carinho

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_HOST=carinho-redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=carinho_cuidadores:

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --------------------------------------------
# Token interno
# --------------------------------------------
INTERNAL_API_TOKEN=
INTERNAL_API_TIMEOUT=5

# --------------------------------------------
# Z-API (WhatsApp)
# --------------------------------------------
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=
ZAPI_TIMEOUT=10
ZAPI_CONNECT_TIMEOUT=3

# --------------------------------------------
# Integrações internas
# --------------------------------------------
CRM_BASE_URL=https://crm.carinho.com.vc/api
CRM_TOKEN=
CRM_TIMEOUT=8

OPERACAO_BASE_URL=https://operacao.carinho.com.vc/api
OPERACAO_TOKEN=

DOCUMENTOS_BASE_URL=https://documentos.carinho.com.vc/api
DOCUMENTOS_TOKEN=
DOCUMENTOS_TIMEOUT=15
DOCUMENTOS_UPLOAD_TIMEOUT=60

ATENDIMENTO_BASE_URL=https://atendimento.carinho.com.vc/api
ATENDIMENTO_TOKEN=
ATENDIMENTO_TIMEOUT=8

INTEGRACOES_BASE_URL=https://integracoes.carinho.com.vc/api
INTEGRACOES_TOKEN=
INTEGRACOES_TIMEOUT=8

# --------------------------------------------
# Negócio deste módulo (não copiar CANCEL_* da Operação)
# --------------------------------------------
CUIDADORES_MAX_WEEKLY_HOURS=44
CUIDADORES_OVERTIME_ALERT=40
CUIDADORES_DOC_EXPIRY_ALERT=30
CUIDADORES_MAX_INCIDENTS=3
CUIDADORES_CACHE_ENABLED=true
CUIDADORES_CACHE_TTL=300

# --------------------------------------------
# Email e marca
# --------------------------------------------
EMAIL_FROM=cuidadores@carinho.com.vc
EMAIL_REPLY_TO=contato@carinho.com.vc
BRAND_NAME="Carinho com Você"
BRAND_DOMAIN=carinho.com.vc
CUIDADORES_SUBDOMAIN=cuidadores.carinho.com.vc
BRAND_SIGNATURE_NAME="Equipe Carinho"
BRAND_REPLY_TO=contato@carinho.com.vc
CUIDADORES_EMAIL_FROM=cuidadores@carinho.com.vc

LOG_CHANNEL=stack
LOG_LEVEL=debug
