{
  "name": "carinho/carinho-crm",
  "type": "project",
  "description": "Carinho CRM system",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-redis": "*",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.9",
    "maatwebsite/excel": "^3.1",
    "spatie/laravel-activitylog": "^4.0",
    "spatie/laravel-permission": "^6.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.29",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    },
    "audit": {
      "block-insecure": false
    },
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "nunomaduro/collision",
        "laravel/sail"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
